{
  "contract": "event_time_precision",
  "version": 1,
  "values": ["date", "second"],
  "date_only": {
    "event_time": null,
    "event_precision": "date"
  },
  "explicit_hh_mm_ss": {
    "event_precision": "second"
  },
  "synthetic_midnight_forbidden": true,
  "unsupported_precision": "reject_without_guessing"
}
